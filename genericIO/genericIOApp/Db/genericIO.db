record(bo, "$(P)$(R)bo$(IDX)") {
  field(DESC, "Binary output $(IDX)")
  field(ZNAM, "Off")
  field(ONAM, "On")
  field(OUT, "$(P)$(R)bi$(IDX) PP")
}

record(bi, "$(P)$(R)bi$(IDX)") {
  field(DESC, "Binary input $(IDX)")
  field(ZNAM, "Off")
  field(ONAM, "On")
  field(PINI, "YES")
}

record(ao, "$(P)$(R)ao$(IDX)") {
  field(DESC, "Analog output $(IDX)")
  field(DRVH, "10000")
  field(HOPR, "10000")
  field(LOPR, "0")
  field(DRVL, "0")
  field(OUT, "$(P)$(R)ai$(IDX) PP")
}

record(ai, "$(P)$(R)ai$(IDX)") {
  field(DESC, "Analog input")
  field(VAL, "0")
  field(HOPR, "10000")
  field(LOPR, "0")
  field(PINI, "YES")
  field(HIHI, "9000")
  field(HHSV, "MAJOR")
  field(HIGH, "8000")
  field(HSV, "MINOR")
  field(LOLO, "1000")
  field(LLSV, "MAJOR")
  field(LOW, "2000")
  field(LSV, "MINOR")
}

record(stringout, "$(P)$(R)stringout$(IDX)") {
  field(DESC, "String output $(IDX)")
  field(OUT, "$(P)$(R)stringin$(IDX) PP")
}

record(stringin, "$(P)$(R)stringin$(IDX)") {
  field(DESC, "String input")
  field(VAL, "hello world!")
  field(PINI, "YES")
}

record(mbbo, "$(P)$(R)mbbo$(IDX)") {
  field(DESC, "Selection out")
  field(OUT,  "$(P)$(R)mbbi$(IDX) PP")
  field(ZRVL, "0")
  field(ZRST, "Option 0")
  field(ONVL, "1")
  field(ONST, "Option 1")
  field(TWVL, "2")
  field(TWST, "Option 2")
  field(THVL, "3")
  field(THST, "Option 3")
  field(FRVL, "4")
  field(FRST, "Option 4")
}

record(mbbi, "$(P)$(R)mbbi$(IDX)") {
  field(DESC, "Selection in")
  field(ZRVL, "0")
  field(ZRST, "Option 0")
  field(ONVL, "1")
  field(ONST, "Option 1")
  field(TWVL, "2")
  field(TWST, "Option 2")
  field(THVL, "3")
  field(THST, "Option 3")
  field(FRVL, "4")
  field(FRST, "Option 4")
}

record(calc, "$(P)$(R)Random$(IDX)") {
  field(DESC, "Random value [0-1] $(IDX)")
  field(CALC, "RNDM")
  field(SCAN, "1 second")
  field(PREC, "5")
}
