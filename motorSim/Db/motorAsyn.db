record(motor,"$(P)$(M)")
{
	field(DESC, "$(DESC)")
	field(DTYP, "$(DTYP)")
	field(DIR,  "$(DIR)")
	field(VELO, "$(VELO)")
	field(VBAS, "$(VBAS)")
	field(ACCL, "$(ACCL)")
	field(ACCU, "$(ACCU=0)")
	field(BDST, "$(BDST)")
	field(BVEL, "$(BVEL)")
	field(BACC, "$(BACC)")
	field(OUT,  "@asyn($(PORT),$(ADDR))")
	field(MRES, "$(MRES)")
	field(PREC, "$(PREC)")
	field(EGU,  "$(EGU)")
	field(DHLM, "$(DHLM)")
	field(DLLM, "$(DLLM)")
	field(INIT, "$(INIT)")
	field(TWV,  "1")
}

record(compress, "$(P)$(M)RBVArr-Mon") {
  field(DESC, "$(M) Position History")
  field(ALG, "Circular Buffer")
  field(INP, "$(P)$(M).RBV")
  field(NSAM, "500")
  field(SCAN, ".1 second")
}

# Motor direction for this axis
record(longout,"$(P)$(M)Direction") {
    field(DESC, "$(M) direction")
    field(DOL,  "$(P)$(M).DIR CP MS")
    field(OMSL, "closed_loop")
    field(DTYP, "asynInt32")
    field(OUT,  "@asyn($(PORT),$(ADDR))MOTOR_REC_DIRECTION")
}

# Motor offset for this axis
record(ao,"$(P)$(M)Offset") {
    field(DESC, "$(M) offset")
    field(DOL,  "$(P)$(M).OFF CP MS")
    field(OMSL, "closed_loop")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR))MOTOR_REC_OFFSET")
    field(PREC, "$(PREC)")
}


# Motor resolution for this axis
record(ao,"$(P)$(M)Resolution") {
    field(DESC, "$(M) resolution")
    field(DOL,  "$(P)$(M).MRES CP MS")
    field(OMSL, "closed_loop")
    field(DTYP, "asynFloat64")
    field(OUT,  "@asyn($(PORT),$(ADDR))MOTOR_REC_RESOLUTION")
    field(PREC, "$(PREC)")
}

## Creates random movement for illustration - can be disabled
record(bo, "$(P)$(M)RandomEnable-Cmd") {
    field(DESC, "Enables random movement of the motor")
    field(ZNAM, "Disabled")
    field(ONAM, "Enabled")
    field(VAL, "1")
    field(PINI, "YES")
}


record(calcout, "$(P)$(M)RandomSP") {
    field(DESC, "Sends a random target pos if enabled")
    field(INPA, "$(P)$(M).DMOV")
    # bit of a hack with NINT to reduce decimal places of output...
    field(CALC, "A ? NINT(RNDM*100*1E5)/1E5 : 0")
    field(PREC, "5")
    field(OOPT, "When Non-zero")
    field(OUT, "$(P)$(M) PP")
    field(SCAN, "10 second")
    field(DISV, "0")
    field(SDIS, "$(P)$(M)RandomEnable-Cmd CP")
}
